<?xml version="1.0" encoding="utf-8"?>
<!-- Xstream Music widget: cover, title, artist, progress, previous / play-pause / next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wm_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_music_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/wm_art"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:contentDescription="Cover"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_shortcut_music" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.08"
            android:text="XSTREAM MUSIC"
            android:textColor="#FFFF5A4E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wm_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Xstream Music"
            android:textColor="#FFFFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/wm_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tap to play songs, albums and videos"
            android:textColor="#FF9AA3B2"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/wm_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="8dp"
            android:max="1000"
            android:progress="0"
            android:progressTint="#FFE50914"
            android:progressBackgroundTint="#FF3A3A44" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/wm_prev"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="6dp"
                android:contentDescription="Previous"
                android:src="@drawable/ic_w_prev" />

            <ImageView
                android:id="@+id/wm_play"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:contentDescription="Play or pause"
                android:src="@drawable/ic_w_play" />

            <ImageView
                android:id="@+id/wm_next"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="6dp"
                android:contentDescription="Next"
                android:src="@drawable/ic_w_next" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
