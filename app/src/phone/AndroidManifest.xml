<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.example.streamnest.MusicActivity"
            android:taskAffinity="com.example.xstream.music"
            android:label="Xstream Music"
            android:icon="@mipmap/ic_launcher_music"
            android:roundIcon="@mipmap/ic_launcher_music"
            android:launchMode="singleTask"
            android:exported="true"
            android:theme="@style/Theme.Xstream">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
