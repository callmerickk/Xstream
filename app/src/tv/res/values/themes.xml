<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="tv_launch_bg">#FF07080C</color>
    <!-- TV: the same theme, with the logo shown while the app starts (it matches the splash's first frame). -->
    <style name="Theme.StreamX" parent="Theme.MaterialComponents.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/tv_launch</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
